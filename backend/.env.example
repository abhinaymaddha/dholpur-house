# Postgres with pgvector (docker-compose provides this)
DATABASE_URL=postgresql://upsc:upsc@localhost:5432/upsc

# API keys for the LLM providers you use. Which provider and model each part of the app uses is set
# in backend/models.toml; each provider there names the variable its key is read from.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local embedding model (fastembed). Changing it requires re-running ingest.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# Set to a long random string to enable /api/admin/ingest (upload a Telegram export)
ADMIN_TOKEN=

CORS_ORIGINS=http://localhost:5173
TELEGRAM_CHANNEL=https://t.me/csetranscripts
LOG_LEVEL=INFO
